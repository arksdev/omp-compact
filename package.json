{
	"name": "omp-compact",
	"version": "1.0.0",
	"description": "Compact, evidence-preserving tool presentation for OMP 17.2.12",
	"type": "module",
	"main": "index.ts",
	"omp": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"omp": "env -u OMP_COMPACT_TOOL_CALLS -u OMP_FOLD_COMPLETED_TURNS -u OMP_TURN_SUMMARY -u OMP_COMPACT_MODE -u OMP_COMPACT_PLUGIN ./node_modules/.bin/omp --no-extensions -e ./index.ts",
		"test": "OMP_STOCK_BIN=./node_modules/.bin/omp bun test --timeout=120000 ./*.test.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome lint ./*.ts replay",
		"format:check": "biome format ./*.ts package.json replay",
		"check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
	},
	"keywords": [
		"omp",
		"plugin",
		"presentation",
		"compact",
		"tool-log",
		"terminal"
	],
	"author": "arksdev",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/arksdev/omp-compact.git"
	},
	"bugs": {
		"url": "https://github.com/arksdev/omp-compact/issues"
	},
	"homepage": "https://github.com/arksdev/omp-compact#readme",
	"engines": {
		"bun": ">=1.3.0"
	},
	"dependencies": {
		"@oh-my-pi/pi-coding-agent": "17.2.12"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"@types/bun": "1.3.14",
		"typescript": "5.9.3"
	},
	"files": [
		"*.ts",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	]
}
