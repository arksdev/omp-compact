{
	"name": "omp-compact",
	"version": "1.2.8",
	"description": "Compact, evidence-preserving tool presentation for OMP",
	"type": "module",
	"main": ".omp-plugin/index.ts",
	"omp": {
		"extensions": [
			"./.omp-plugin/index.ts"
		]
	},
	"scripts": {
		"omp": "env -u OMP_COMPACT_TOOL_CALLS -u OMP_FOLD_COMPLETED_TURNS -u OMP_TURN_SUMMARY -u OMP_COMPACT_MODE -u OMP_COMPACT_PLUGIN ./node_modules/.bin/omp --no-extensions -e ./.omp-plugin/index.ts",
		"test": "OMP_STOCK_BIN=./node_modules/.bin/omp bun test --timeout=120000 docs/tests",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome lint .omp-plugin docs/tests",
		"format:check": "biome format .omp-plugin package.json docs/tests",
		"check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
	},
	"keywords": [
		"omp",
		"plugin",
		"presentation",
		"compact",
		"tool-log",
		"terminal"
	],
	"author": "arksdev",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/arksdev/omp-compact.git"
	},
	"bugs": {
		"url": "https://github.com/arksdev/omp-compact/issues"
	},
	"homepage": "https://github.com/arksdev/omp-compact#readme",
	"engines": {
		"bun": ">=1.3.0",
		"omp": ">=18.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@oh-my-pi/pi-coding-agent": "18.2.0",
		"@types/bun": "1.4.0",
		"typescript": "6.0.3"
	},
	"files": [
		".omp-plugin/*.ts",
		"README.md",
		"README.en.md",
		"CHANGELOG.md",
		"LICENSE"
	]
}
