{
	"compilerOptions": {
		"target": "ES2024",
		"module": "ESNext",
		"lib": ["ES2024"],
		"moduleResolution": "Bundler",
		"moduleDetection": "force",
		"strict": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedLocals": true,
		"skipLibCheck": true,
		"allowArbitraryExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["bun"],
		"typeRoots": ["./node_modules/@types"]
	},
	"include": ["**/*.ts"],
	// Fourth entry is one directory literally named "reports, ideas, features"
	// (commas and spaces in the name). Splitting it into three elements would
	// silently un-exclude that directory.
	"exclude": ["node_modules", "omp-compact", "runtime", "reports, ideas, features", "tools"]
}
